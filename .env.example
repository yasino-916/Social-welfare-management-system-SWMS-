# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=poverty_support_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=8h

# File Storage
STORAGE_TYPE=local           # local | s3
STORAGE_LOCAL_PATH=./uploads
# AWS S3 (if STORAGE_TYPE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# Email (optional)
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=noreply@wereda.gov.et

# SMS (optional)
SMS_ENABLED=false
SMS_PROVIDER=
SMS_API_KEY=

# Audit
AUDIT_LOG_ENABLED=true
